# Explicit public release and curated historical-source allowlist.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSES/
!/AGENTS.md
!/releases/
/releases/*
!/releases/v1.0.0/
!/docs/
/docs/*
!/docs/release/
!/docs/verification.md
!/docs/project-brief.md
!/docs/rights-and-provenance.md
!/docs/art-direction/
/docs/art-direction/*
!/docs/art-direction/current-completion-state.json
!/docs/art-direction/remaining-scene-roadmap.md
!/docs/art-direction/render-cache-workflow.md
!/docs/art-direction/freestyle-performance-257.md
!/tools/
/tools/*
!/tools/release/
**/__pycache__/
**/*.blend1
**/.DS_Store
/releases/v1.0.0/output/

# Explicit guardrails in addition to the root allowlist.
/private/
/references/
/archives/

# Reviewed text-only source history; original research remains local.
!/research/
